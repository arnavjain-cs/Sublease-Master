{
  "name": "sublease-master",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/start.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "NODE_ENV=production node server/start.js",
    "test": "node --test server/*.test.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.7",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@libsql/client": "^0.18.0",
    "@phosphor-icons/react": "^2.1.7",
    "@vercel/blob": "^2.8.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.0",
    "stripe": "^18.4.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "vite": "^7.0.6"
  }
}
