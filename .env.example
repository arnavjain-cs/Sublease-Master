PORT=3001
HOST=
APP_ORIGIN=http://127.0.0.1:5173
DATA_DIR=./data
UPLOAD_DIR=./public/uploads
# Vercel: connect Turso and Vercel Blob in the project dashboard. Their
# integrations supply these values; leave them unset for local SQLite/photos.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
# Set to 0 in Vercel Project Settings so Express receives raw request streams.
NODEJS_HELPERS=0
PAYMENTS_MODE=demo
# Set PAYMENTS_MODE=stripe and provide the server-side Stripe values for real $25 listing checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Production signup requires SMTP so email verification codes can be delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sublease Master <hello@example.com>
# Add comma-separated school domains if they do not use .edu or .ac.*
ALLOWED_SCHOOL_DOMAINS=
SEED_DEMO=true
